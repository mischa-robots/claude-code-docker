# Copy this to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────────

# Timezone (default: UTC)
# TZ=Europe/Berlin

# Project directory to mount into /workspace (default: current directory)
# PROJECT_DIR=/home/you/projects/my-project
