# Copy this to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────────

# Timezone (default: UTC)
# TZ=Europe/Berlin

# Project directory to mount into /workspace (default: ./projects)
# Clone your projects into the projects/ folder, or point this at any
# existing directory on your host (e.g. ~/projects).
PROJECT_DIR=./projects
